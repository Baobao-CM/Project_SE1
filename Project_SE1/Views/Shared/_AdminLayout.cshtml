@inject IHttpContextAccessor HttpContextAccessor
@{
    var userId = HttpContextAccessor.HttpContext.Session.GetInt32("UserId");

    if (userId == null)
    {
        <script>
            window.location.href = '@Url.Action("Login", "Users")';
        </script>
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="description" content="" />
    <meta name="author" content="" />
    <title>Dashboard - SB Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/simple-datatables@7.1.2/dist/style.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/project_dnc_se1.styles.css" asp-append-version="true" />
    <link href="/css/styles.css" rel="stylesheet" />
    <link href="/css/custom.css" rel="stylesheet" />
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/lib/bootstrap/bootstrap-icons/bootstrap-icons.css"
    <link rel="stylesheet" type="text/css" href="/css/slick-theme.css" />
    <link rel="stylesheet" type="text/css" href="/css/slick.css" />




    <script src="https://use.fontawesome.com/releases/v6.3.0/js/all.js" crossorigin="anonymous"></script>

</head>
<body class="sb-nav-fixed">
    <nav class="sb-topnav navbar navbar-expand navbar-dark bg-dark justify-content-between">
        <!-- Navbar Brand-->
        <a class="navbar-brand ps-3" href="index.html">Cần Thơ Wedding</a>
        <div class="d-flex justify-content-between align-items-center w-100">

            <!-- Sidebar Toggle-->
            <button class="btn btn-link btn-sm order-1 order-lg-0 me-4 me-lg-0 ms-lg-4" id="sidebarToggle" href="#!"><i class="fas fa-bars"></i></button>
            <!-- Navbar-->
            <ul class="navbar-nav ms-auto ms-md-0 me-3 me-lg-4">
                @if (HttpContextAccessor.HttpContext.Session.GetString("FullName") != null)
                {

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fas fa-user fa-fw"></i> @HttpContextAccessor.HttpContext.Session.GetString("FullName")
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item text-danger" asp-controller="Users" asp-action="Logout">Đăng xuất</a></li>
                        </ul>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Users" asp-action="Login"><i class="fas fa-sign-in-alt"></i> Đăng nhập</a>
                    </li>
                }
            </ul>
        </div>

    </nav>
    <div id="layoutSidenav">
        <div id="layoutSidenav_nav">
            <nav class="sb-sidenav accordion sb-sidenav-dark" id="sidenavAccordion">
                <div class="sb-sidenav-menu">
                    <div class="nav">
                        <a class="nav-link" href="/">
                            <div class="sb-nav-link-icon"><i class="fas fa-tachometer-alt"></i></div>
                            Trang chủ
                        </a>
                        @* start Product *@
                        <a class="nav-link collapsed" href="#" data-bs-toggle="collapse" data-bs-target="#collapseProducts" aria-expanded="false" aria-controls="collapsePages">
                            <div class="sb-nav-link-icon"><i class="fas fa-book-open"></i></div>
                            Sản phẩm
                            <div class="sb-sidenav-collapse-arrow"><i class="fas fa-angle-down"></i></div>
                        </a>
                        <div class="collapse" id="collapseProducts" aria-labelledby="headingTwo" data-bs-parent="#sidenavAccordion">
                            <nav class="sb-sidenav-menu-nested nav accordion" id="sidenavAccordionPages">
                                <a class="nav-link" asp-area="" asp-controller="ProductCategories" asp-action="Index">
                                    <div class="sb-nav-link-icon"><i class="fas fa-chart-area"></i></div>
                                    Danh mục sản phẩm
                                </a>
                                <a class="nav-link" asp-area="" asp-controller="Products" asp-action="Index">
                                    <div class="sb-nav-link-icon"><i class="fas fa-chart-area"></i></div>
                                    Danh sách sản phẩm
                                </a>
                            </nav>
                        </div>
                        @* end Product *@
                        @* start news *@
                        <a class="nav-link collapsed" href="#" data-bs-toggle="collapse" data-bs-target="#collapseNews" aria-expanded="false" aria-controls="collapsePages">
                            <div class="sb-nav-link-icon"><i class="fas fa-book-open"></i></div>
                            Tin tức
                            <div class="sb-sidenav-collapse-arrow"><i class="fas fa-angle-down"></i></div>
                        </a>
                        <div class="collapse" id="collapseNews" aria-labelledby="headingTwo" data-bs-parent="#sidenavAccordion">
                            <nav class="sb-sidenav-menu-nested nav accordion" id="sidenavAccordionPages">
                                <a class="nav-link" asp-area="" asp-controller="NewsCategories" asp-action="Index">
                                    <div class="sb-nav-link-icon"><i class="fas fa-chart-area"></i></div>
                                    Danh mục tin tức
                                </a>
                                <a class="nav-link" asp-area="" asp-controller="News" asp-action="Index">
                                    <div class="sb-nav-link-icon"><i class="fas fa-chart-area"></i></div>
                                    Danh sách tin tức
                                </a>
                            </nav>
                        </div>
                        @* end News *@
                        @* start Events *@
                        <a class="nav-link collapsed" href="#" data-bs-toggle="collapse" data-bs-target="#collapseEvents" aria-expanded="false" aria-controls="collapsePages">
                            <div class="sb-nav-link-icon"><i class="fas fa-book-open"></i></div>
                            Sự kiện
                            <div class="sb-sidenav-collapse-arrow"><i class="fas fa-angle-down"></i></div>
                        </a>
                        <div class="collapse" id="collapseEvents" aria-labelledby="headingTwo" data-bs-parent="#sidenavAccordion">
                            <nav class="sb-sidenav-menu-nested nav accordion" id="sidenavAccordionPages">
                                <a class="nav-link" asp-area="" asp-controller="EventsCategories" asp-action="Index">
                                    <div class="sb-nav-link-icon"><i class="fas fa-chart-area"></i></div>
                                    Danh mục sự kiện
                                </a>
                                <a class="nav-link" asp-area="" asp-controller="Events" asp-action="Index">
                                    <div class="sb-nav-link-icon"><i class="fas fa-chart-area"></i></div>
                                    Danh sách sự kiện
                                </a>
                            </nav>
                        </div>
                        @* end Events *@
                        @{
                            var role = Context.Session.GetInt32("UserRole");
                        }
                        @if (role == 0)
                        {
                            <a class="nav-link" asp-area="" asp-controller="Users" asp-action="Index">
                                <div class="sb-nav-link-icon"><i class="fas fa-chart-area"></i></div>
                                Người dùng
                            </a>
                            <a class="nav-link" asp-area="" asp-controller="CompanyInfoes" asp-action="Index">
                                <div class="sb-nav-link-icon"><i class="fas fa-chart-area"></i></div>
                                Thông tin
                            </a>
                        }
                        </a>
                        <a class="nav-link" asp-area="" asp-controller="ContactInfoes" asp-action="Index">
                            <div class="sb-nav-link-icon"><i class="fas fa-chart-area"></i></div>
                            Liên hệ
                        </a>

                    </div>
                </div>
                <div class="sb-sidenav-footer">
                    <div class="small">Người dùng:</div>
                    @HttpContextAccessor.HttpContext.Session.GetString("FullName")
                </div>
            </nav>
        </div>
        <div id="layoutSidenav_content">
            <main>
                <div class="container-fluid p-4">


                    @RenderBody()


                </div>
            </main>
            <footer class="py-4 bg-light mt-auto">
                <div class="container-fluid px-4">
                    <div class="d-flex align-items-center justify-content-between small">
                        <div class="text-muted">Copyright &copy; 2025 Cần Thơ Wedding.</div>
                        <div>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </div>
    <script src="/js/scripts.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.8.0/Chart.min.js" crossorigin="anonymous"></script>
    <script src="/assets/demo/chart-area-demo.js"></script>
    <script src="/assets/demo/chart-bar-demo.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/simple-datatables@7.1.2/dist/umd/simple-datatables.min.js" crossorigin="anonymous"></script>
    <script src="/js/datatables-simple-demo.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script type="text/javascript" src="/js/slick.min.js"></script>
    <script>
        $(document).ready(function () {
            $('.slider-for').slick({
                slidesToShow: 1,
                slidesToScroll: 1,
                arrows: true,
                fade: true,
                asNavFor: '.slider-nav'
            });

            $('.slider-nav').slick({
                slidesToShow: 3,
                slidesToScroll: 1,
                asNavFor: '.slider-for',
                dots: false,
                centerMode: true,
                focusOnSelect: true
            });
        });
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>

