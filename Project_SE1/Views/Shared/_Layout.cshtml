@inject IHttpContextAccessor HttpContextAccessor
<!DOCTYPE html>
<html lang="vi" class="h-100">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Lynn bridal</title>

    <!-- Bootstrap & Slick -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick-theme.css" />

    <!-- Font Awesome / Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/custom.css" />
    <link rel="stylesheet" href="/css/UI.css" />
</head>
<body class="d-flex flex-column min-vh-100">

    <!-- 🔝 Sub-header -->
    <div class="sub-header text-white bg-dark py-1">
        <div class="container d-flex justify-content-between align-items-center flex-wrap small">
            <div>
                <!-- Hotline -->
                @if (ViewData["Hotline"] != null)
                {
                    <small class="mb-1 d-block"><a href="tel: @ViewData["Hotline"]" class="text-white"><i class="bi bi-telephone-fill"></i> @ViewData["Hotline"]</a></small>
                }
                @if (ViewData["Address"] != null)
                {
                    <small><i class="bi bi-house-door-fill"></i> @ViewData["Address"]</small>
                }
            </div>

            <div class="d-flex gap-2">
                <a href="@ViewData["Facebook"]" target="_blank" class="btn rounded-circle d-flex align-items-center justify-content-center btn-social">
                    <i class="bi bi-facebook"></i>
                </a>
                <a href="@ViewData["TikTok"]" target="_blank" class="btn rounded-circle d-flex align-items-center justify-content-center btn-social">
                    <i class="bi bi-tiktok"></i>
                </a>
                <a href="@ViewData["Instagram"]" target="_blank" class="btn rounded-circle d-flex align-items-center justify-content-center btn-social">
                    <i class="bi bi-instagram"></i>
                </a>
                <a href="@ViewData["YouTube"]" target="_blank" class="btn rounded-circle d-flex align-items-center justify-content-center btn-social">
                    <i class="bi bi-youtube"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- 🌸 Header + Navbar -->
    <header class="main-header" style="background-color: var(--primary-color); color: white;">
        <div class="container">
            <nav class="navbar navbar-expand-lg navbar-dark">
                <a class="navbar-brand fw-bold" href="#">Lynn Bridal</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item"><a href="#home" class="nav-link">Trang chủ</a></li>
                        <li class="nav-item"><a href="#product" class="nav-link">Sản phẩm</a></li>
                        <li class="nav-item"><a href="#news" class="nav-link">Tin tức</a></li>
                        <li class="nav-item"><a href="#event" class="nav-link">Sự kiện</a></li>
                        <li class="nav-item"><a href="#contact" class="nav-link">Liên hệ</a></li>
                    </ul>

                    <!-- Phần user -->
                    <ul class="navbar-nav">
                        @if (HttpContextAccessor.HttpContext.Session.GetString("FullName") != null)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                                    <i class="fas fa-user fa-fw"></i> @HttpContextAccessor.HttpContext.Session.GetString("FullName")
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-controller="Users" asp-action="RedirectToManager">Quản lí</a></li>
                                    <li><a class="dropdown-item text-danger" asp-controller="Users" asp-action="Logout">Đăng xuất</a></li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Users" asp-action="Login">
                                    <i class="fas fa-sign-in-alt"></i> Đăng nhập
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </nav>
        </div>
    </header>



    <!-- ⭐ Nội dung chính -->
    @RenderBody()


    <!-- 👣 Footer -->
    <footer class="text-white py-5 mt-auto">
        <div class="container">
            <div class="row">
                <div class="col-3">
                    <h5 class="fw-bold">VỀ CHÚNG TÔI</h5>
                    <p class="">Dể tiện phục vụ quý khách được tốt nhất xin quý khách vui lòng nhắn tin trước cho shop nhé </p>
                </div>
                <div class="col-3">
                    <h5 class="fw-bold">LIÊN HỆ</h5>
                    <ul class="list-unstyled">
                        <li>
                            @if (ViewData["Address"] != null)
                            {
                                <small><i class="bi bi-house-door-fill"></i> @ViewData["Address"]</small>
                            }
                        </li>
                        <li><small><i class="bi bi-telephone-fill"></i> @ViewData["Hotline"]</small></li>
                        <li><small><i class="bi bi-envelope-open"></i> @ViewData["Email"]</small></li>
                    </ul>
                </div>

            </div>
        </div>
    </footer>

    <div class="bg-dark text-white py-2 mt-auto">
        <div class="container text-center">
            &copy; 2025 - Lynn Bridal. Đã đăng ký bản quyền.
        </div>
    </div>

    <!-- JS thư viện -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"></script>
    <script src="/js/slider.js"></script>


    @RenderSection("Scripts", required: false)
</body>
</html>
