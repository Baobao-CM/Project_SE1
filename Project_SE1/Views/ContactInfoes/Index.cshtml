@model IEnumerable<project_dnc_se1.Models.ContactInfo>

@{
    ViewData["Title"] = "Index";
}

<h1>Liên hệ khách hàng</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Tạo mới liên hệ</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                Tiêu đề
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                Tin nhắn
            </th>
            <th>
                Sự kiện
            </th>
            <th>
                Sản phẩm
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Title)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Email)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Message)
                </td>
                <td>
                    @Html.Raw(item?.Events?.Title ?? "--")
                </td>
                <td>
                    @Html.Raw(item?.Product?.Title ?? "--")
                </td>

                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="text-decoration-none">
                        <i class="bi bi-pencil-square"></i>
                    </a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none">
                        <i class="bi bi-journal-richtext"></i>
                    </a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="text-decoration-none">
                        <i class="bi bi-trash"></i>
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
