@model project_dnc_se1.Models.ContactInfo

@{
    ViewData["Title"] = "Details";
}

<h1>Chi tiết thông tin liên hệ</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Tiêu đề
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Title)
        </dd>
        <dt class="col-sm-2">
