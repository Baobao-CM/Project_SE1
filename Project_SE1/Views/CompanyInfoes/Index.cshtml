@using project_dnc_se1.Helpers
@model IEnumerable<project_dnc_se1.Models.CompanyInfo>

@{
    ViewData["Title"] = "Index";
}

<h1>Thông tin doanh nghiệp</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Tạo thông tin</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                Tiêu đề
            </th>
            <th>
                Mô tả
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Title)
                </td>
                <td>
                    <div class="d-flex gap-1">

                        @Html.DisplayUploadOrText(item.Value)
                    </div>
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="text-decoration-none">
                        <i class="bi bi-pencil-square"></i>
                    </a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none">
                        <i class="bi bi-journal-richtext"></i>
                    </a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="text-decoration-none">
                        <i class="bi bi-trash"></i>
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
