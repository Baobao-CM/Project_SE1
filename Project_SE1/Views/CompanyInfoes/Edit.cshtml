@model project_dnc_se1.Models.CompanyInfo

@{
    ViewData["Title"] = "Chỉnh sửa";
    var isImage = ViewData["IsImage"] as bool? ?? false;
}

<h1>Chỉnh sửa thông tin</h1>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" enctype="multipart/form-data">
            <input type="hidden" name="id" value="@Model.Id" />

            <div class="form-group">
                <label>Tiêu đề</label>
                <input name="Title" class="form-control" value="@Model.Title" />
            </div>

            <div class="form-group">
                <label>Loại nội dung</label><br />
                <input type="radio" name="ValueType" value="text" @(isImage ? "" : "checked") onchange="toggleFields()" /> Văn bản
                <input type="radio" name="ValueType" value="image" @(isImage ? "checked" : "") onchange="toggleFields()" /> Hình ảnh
            </div>

            <div class="form-group" id="textValue">
                <label>Nội dung văn bản</label>
                <textarea name="ValueText" class="form-control">@(!isImage ? Model.Value : "")</textarea>
            </div>

            <div class="form-group" id="imageValue">
                <label>Chọn ảnh mới (nếu muốn thay đổi)</label>
                <input name="ValueImage" type="file" class="form-control" accept="image/*" multiple />
                @if (isImage && !string.IsNullOrEmpty(Model.Value))
                {
                    <div class="mt-2">
                        <label>Ảnh hiện tại:</label>
                        <br />
                        @{
                            var imagePaths = Model.Value.Split(';');
                            foreach (var path in imagePaths)
                            {
                                <img src="@path" alt="Current Image" width="100" class="mr-2 mb-2" />
                            }
                        }
                    </div>
                }
            </div>

            <button type="submit" class="btn btn-primary">Cập nhật</button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function toggleFields() {
            var type = document.querySelector('input[name="ValueType"]:checked').value;
            document.getElementById('textValue').style.display = (type === "text") ? "block" : "none";
            document.getElementById('imageValue').style.display = (type === "image") ? "block" : "none";
        }
        toggleFields(); // chạy khi load trang
    </script>

    @await Html.PartialAsync("_ValidationScriptsPartial")
}
