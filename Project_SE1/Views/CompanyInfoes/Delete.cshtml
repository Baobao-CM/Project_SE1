@model project_dnc_se1.Models.CompanyInfo

@{
    ViewData["Title"] = "Delete";

    bool isImage = !string.IsNullOrEmpty(Model.Value) && Model.Value.Contains("/uploads/");
}

<h1>Xoá thông tin</h1>

<h3>Bạn có chắc muốn xoá thông tin này?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Tiêu đề
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Title)
        </dd>

        <dt class="col-sm-2">
            Mô tả
        </dt>
        <dd class="col-sm-10">
            @if (isImage)
            {
                foreach (var url in Model.Value.Split(';', StringSplitOptions.RemoveEmptyEntries))
                {
                    <img src="@url" alt="Ảnh mô tả" class="img-thumbnail me-2 mb-2" style="max-width: 200px;" />
                }
            }
            else
            {
                <p>@Model.Value</p>
            }
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Xoá" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
    </form>
</div>
