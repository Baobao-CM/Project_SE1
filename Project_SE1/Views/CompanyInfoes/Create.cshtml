@model project_dnc_se1.Models.CompanyInfo

@{
    ViewData["Title"] = "Create";
}

<h1>Tạo mới thông tin</h1>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" enctype="multipart/form-data">
            <div class="form-group">
                <label>Tiêu đề</label>
                <input name="Title" class="form-control" />
            </div>

            <div class="form-group">
                <label>Loại nội dung</label><br />
                <input type="radio" name="valueType" value="text" checked onchange="toggleFields()" /> Văn bản
                <input type="radio" name="valueType" value="image" onchange="toggleFields()" /> Hình ảnh
            </div>

            <div class="form-group" id="textValue">
                <label>Nội dung văn bản</label>
                <textarea name="ValueText" class="form-control"></textarea>
            </div>

            <div class="form-group" id="imageValue" style="display:none">
                <label>Chọn ảnh</label>
                <input name="ValueImage" type="file" class="form-control" accept="image/*" multiple />
            </div>

            <button type="submit" class="btn btn-primary">Lưu</button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function toggleFields() {
            var type = document.querySelector('input[name="valueType"]:checked').value;
            document.getElementById('textValue').style.display = (type === "text") ? "block" : "none";
            document.getElementById('imageValue').style.display = (type === "image") ? "block" : "none";
        }
        toggleFields(); // Gọi khi load trang
    </script>

    @await Html.PartialAsync("_ValidationScriptsPartial")
}
