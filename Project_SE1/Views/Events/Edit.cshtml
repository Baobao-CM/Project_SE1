@model project_dnc_se1.Models.Event

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml"; // đường dẫn tới layout admin
    ViewData["Title"] = "Sửa Sự kiện";

}
<h1>Sửa sự kiện</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" enctype="multipart/form-data">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" name="OldBanners" value="@Model.Banners" />

            <div class="form-group">
                <label asp-for="Title" class="control-label">Tiêu đề</label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="form-group mt-3">
                <label asp-for="Value" class="control-label">Mô tả</label>
                <input asp-for="Value" class="form-control" />
                <span asp-validation-for="Value" class="text-danger"></span>
            </div>
            <div class="form-group mt-3">
                <label asp-for="CategoryId" class="control-label">Danh mục</label>
                <select asp-for="CategoryId" class="form-control" asp-items="ViewBag.CategoryId"></select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>
            <div class="form-group mt-3">
                @*                 <label asp-for="Banners" class="control-label"></label>
                <input asp-for="Banners" class="form-control" />
                <span asp-validation-for="Banners" class="text-danger"></span> *@
                <label class="control-label">Ảnh hiện tại</label>
                @if (!string.IsNullOrEmpty(Model.Banners))
                {
                                    <div class="mb-2">
                                        <img src="@Model.Banners" class="img-banners" style="width: 200px; height: 200px; object-fit: cover;" />
                                    </div>
                }
                else
                {
                                    <div class="mb-2 text-muted">Chưa có ảnh.</div>
                }

                <label class="control-label">Tải ảnh mới lên</label>
                <input type="file" name="BannersFile" class="form-control" />
            </div>
            <div class="form-group mt-3 d-flex gap-2">
                <input type="submit" value="Lưu" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
            </div>


            @if (!ViewData.ModelState.IsValid)
            {
                                <div class="alert alert-danger">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                                                        <div>@error.ErrorMessage</div>
                    }
                                </div>
            }
        </form>
    </div>
</div>



@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
