@model project_dnc_se1.Models.News

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml"; // đường dẫn tới layout admin
    ViewData["Title"] = "Chi tiết tin tức";

}

<h1>Chi tiết tin tức</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Tên tin tức
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Title)
        </dd>
        <dt class="col-sm-2">
            Mô tả
        </dt>
        <dd class="col-sm-10">
            @Html.Raw(Model.Value)
        </dd>
        <dt class="col-sm-2">
            Ảnh bìa
        </dt>
        <dd class="col-sm-10">
            <img src="@Model.Banners" alt="Ảnh bìa" width="100" />

        </dd>
        @*         <dt class = "col-sm-2">
        @Html.DisplayNameFor(model => model.UpdatedAt)
        </dt>
        <dd class = "col-sm-10">
        @Html.DisplayFor(model => model.UpdatedAt)
        </dd> *@
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.IsDeleted)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.IsDeleted)
        </dd>
        <dt class="col-sm-2">
            Danh mục
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Category.Title)
        </dd>
        <dt class="col-sm-2">
            Người tạo
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.User.FullName)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" class="btn btn-primary" asp-route-id="@Model?.Id"> Sửa</a>
    <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
</div>
